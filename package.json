{
  "name": "openchamber-omlx-monitor",
  "version": "1.0.0",
  "description": "Real-time oMLX server monitor: active model request prefill/generate/waiting status via Admin API",
  "private": true,
  "type": "module",
  "license": "MIT",
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.3.3"
    },
    "contributes": {
      "panel": {
        "id": "omlx-monitor",
        "name": "oMLX Monitor",
        "icon": "pulse",
        "entry": "panel/index.html"
      },
      "statusSection": {
        "entry": "status/index.html",
        "title": "oMLX Status",
        "height": 180
      },
      "service": {
        "entry": "service/main.js",
        "runtime": "host",
        "permissions": {
          "exec": [
            "ps",
            "lsof"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src"
  },
  "devDependencies": {
    "@openchamber/sdk": "^2.3.3",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.2"
  }
}
